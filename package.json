{
  "name": "intentlock",
  "private": true,
  "type": "module",
  "scripts": {
    "test:browser": "playwright test --config=playwright.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify:static": "node --test tests/static-smoke.test.mjs tests/manifest-runtime.test.mjs tests/content-bootstrap.test.mjs",
    "package": "node scripts/package-release.mjs",
    "validate:version": "node scripts/validate-version.mjs",
    "lint": "eslint .",
    "audit:prod": "npm audit --audit-level=moderate",
    "check": "npm run lint && npm test && npm run verify:static && npm run validate:version -- \"v$(node -p \"require('./manifest.json').version\")\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.60.0",
    "eslint": "10.12.0",
    "globals": "17.13.0"
  },
  "engines": {
    "node": ">=18"
  }
}
